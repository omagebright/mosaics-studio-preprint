~sim_gen_def[
   \simulation_typ{PT}
   \minimize_tol{1.e-3}
   \minimize_type{bfgs}
   \minimize_report{0}
   \energy_report{2}
   \prop_type{tors}
   \prop_tors_sig{0.0}
   \prop_trans_sig{0.0}
   \prop_rot_sig{0.0}
   \prop_tors_type{full}
   \replica_number{0}
   \prob_eemc_jump{0.15}
   \eemc_disk_size{10}
   \energy_gap{1.1}
   \total_step_mc{1}
   \local_step_md{1}
   \time_step_md{0.4}
   \statistics_freq{1}
   \burn_in_B{1}
   \burn_in_N{1}
   \write_energy_unit{kcal}
   \temperature{300}
   \inter_list{none}
   \rinter_switch_length{0}
   \rinter_exclude_length{1000}
   \random_seed{-7143580450}
   \EEMC_Emin{-1.0}
   \EEMC_Emax{0.0}
]

