# Consistent gallery style for the eleven single-point systems.
set ray_opaque_background, 0
bg_color white
set antialias, 2
set ray_trace_mode, 0
set ray_shadows, 0
set ambient, 0.35
set direct, 0.6
set specular, 0.15
set spec_power, 60
set cartoon_transparency, 0
set cartoon_ring_mode, 3
set cartoon_ring_finder, 1
set cartoon_nucleic_acid_mode, 4
set cartoon_ladder_mode, 1
set cartoon_ring_transparency, 0.0
set cartoon_tube_radius, 0.35
set stick_radius, 0.22
set orthoscopic, 1
set depth_cue, 0
set_color cprot, [42, 120, 214]
set_color cprot2, [134, 182, 239]
set_color cdna, [235, 104, 52]
set_color crna, [27, 175, 122]
set_color cpep, [237, 161, 0]
set_color cgrey, [110, 110, 110]
